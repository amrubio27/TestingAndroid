root = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
insert_final_newline = true
# Reglas desactivadas (legacy + modern sintaxis) para parar el ciclo de
# 'ktlint rompe CI por cosas cosméticas':
#   - no-trailing-newline: archivos sin \n final funcionan exactamente igual
#   - backing-property: en fakes/tests no siempre hace falta accessor público
#   - filename: builders/mothers/extension-functions no encajan 1-a-1 con el archivo
#   - function-body-expression: muy común en one-liners de tests (cannot be auto-corrected)
# Para reactivar cualquier regla basta con quitarla de la lista o de las ktlint_*.
disabled_rules = no-trailing-newline, backing-property, filename, function-body-expression
ktlint_no-trailing-newline = disabled
ktlint_backing-property = disabled
ktlint_filename = disabled
ktlint_function-body-expression = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[**/*Test.kt]
max_line_length = 160